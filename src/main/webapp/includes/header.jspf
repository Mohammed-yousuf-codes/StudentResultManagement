<%@ page contentType="text/html;charset=UTF-8" %>
<%
String active = request.getServletPath();
String adminName = (String) session.getAttribute("admin");
%>
<div class="app-shell">
<aside class="sidebar">
  <a class="brand" href="dashboard"><span class="brand-mark">SR</span><span>STUDENT<span class="brand-light">PORTAL</span></span></a>
  <div class="nav-caption">WORKSPACE</div>
  <a class="nav-link <%= active.contains("dashboard") ? "active" : "" %>" href="dashboard"><span>▦</span> Overview</a>
  <a class="nav-link <%= active.contains("students") ? "active" : "" %>" href="students"><span>♙</span> Students</a>
  <a class="nav-link <%= active.contains("marks") ? "active" : "" %>" href="marks"><span>✎</span> Enter marks</a>
  <a class="nav-link <%= active.contains("results") ? "active" : "" %>" href="results"><span>▤</span> Results</a>
  <div class="sidebar-bottom"><div class="admin-avatar">A</div><div><b><%= adminName == null ? "Administrator" : adminName %></b><small>System admin</small></div><a class="logout" href="logout" title="Sign out">↗</a></div>
</aside>
<main class="main-area">
<header class="topbar"><div><span class="topbar-kicker">ACADEMIC PORTAL</span><strong>Student Management</strong></div><div class="topbar-right"><span class="status-dot"></span> System online <span class="topbar-divider"></span><span class="user-chip"><%= adminName == null ? "Admin" : adminName %></span></div></header>
<div class="page-content">
